# React Native's Metro bundler and Gradle autolinking both walk node_modules
# expecting a flat tree. pnpm's default symlinked layout hides transitive
# native modules from them, so lay the tree out flat like npm does.
# pnpm keeps its content-addressed store and lockfile either way.
node-linker=hoisted

# React Native and Metro exclude Node 21 and 23, so a wrong major surfaces as an
# obscure bundler crash. Turn the engines range in package.json into a hard stop
# at install time instead.
engine-strict=true
